# ---------------- 虚拟环境 ----------------
venv-gld/
.venv/
.venv-ocr/
env/

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------------- 训练/编译缓存 ----------------
unsloth_compiled_cache/
*.log
*.deleteme

# ---------------- 模型权重（体积大，从 HF 拉取） ----------------
*.safetensors
*.bin
*.gguf

# ---------------- 数据（大文件，可由脚本重建） ----------------
data/synthetic/*
!data/synthetic/.gitkeep
data/public/*
!data/public/.gitkeep
# 跑批续跑标记（不是数据，别入库）
data/processed/*.done
# 探针文件与已弃用数据集的分片（本地保留，不影响任何已发布结果）
data/processed/dpo_pilot.jsonl
data/processed/dpo_probe.jsonl
data/processed/xfund_train.jsonl
data/processed/xfund_val.jsonl

# ---------------- 产出（模型 checkpoint 太大，不进库） ----------------
outputs/*
!outputs/.gitkeep

# 但交付文档必须进库，否则 README 里的 Demo 图在仓库里是裂的
!outputs/*.md
!outputs/*.png
!outputs/*.html
!outputs/*summary.json
!outputs/prompt_*.txt
!outputs/dspy_optimized_flat.txt

# 已并入 outputs/reports_appendix.md 的逐配置小报告
# （内容全部保留在附录里；本地文件保留，src/analyze_errors.py 与 src/inject_knowledge.py 可重新生成）
outputs/report_err_*.md
outputs/report_zero_abl.md
outputs/report_inject_abl_base.md
outputs/report_inject_zero_abl.md
outputs/report_inject_zero_abl_inj.md
outputs/report_inject_api_ds.md
outputs/report_inject_api_ds_nothk.md

# ---------------- 临时调试产物 ----------------
*.out
_*.txt

# ---------------- 本地笔记 / 工作记忆（不进公开仓库） ----------------
.workbuddy/
private/

# 含求职策略（简历写法 / 面试预备）的文档，不进公开仓库
docs/多模态实习项目方案.md
docs/多模态实习项目方案_v2.md
requirements-backup.txt

# ---------------- 密钥 ----------------
.env
*.key

# ---------------- 编辑器 / 系统 ----------------
.vscode/
.idea/
Thumbs.db
desktop.ini

